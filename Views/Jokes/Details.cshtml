@model JokesApp.Models.Joke

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Joke</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.JokesQuestion)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.JokesQuestion)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.JokesAnswer)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.JokesAnswer)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Likes)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Likes)
        </dd>
    </dl>
</div>
<hr />
<h4>Comments</h4>

@if (Model.Comments != null && Model.Comments.Count > 0)
{
    <ul class="list-group mb-4">
        @foreach (var c in Model.Comments)
        {
            <li class="list-group-item">
                <strong>@c.UserEmail:</strong> @c.Text
            </li>
        }
    </ul>
}
else
{
    <p class="text-muted">No comments yet. Be the first to comment!</p>
}

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="card card-body bg-light mt-3">
        <form asp-action="AddComment" method="post">
            <input type="hidden" name="JokeId" value="@Model.Id" />
            <div class="form-group">
                <textarea name="Text" class="form-control" rows="3" placeholder="Write your comment here..." required></textarea>
            </div>
            <button type="submit" class="btn btn-primary mt-2">Post Comment</button>
        </form>
    </div>
}
else
{
    <div class="alert alert-warning mt-3">
        You must log in to add a comment.
    </div>
}
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
